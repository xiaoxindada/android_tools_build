{
  "cfg_blocklist": [
    "std_atomic64"
  ],
  "sdk_version": "29",
  "min_sdk_version": "29",
  "ota_recovery_ramdisk_available": true,
  "run_cargo": true,
  "ramdisk_available": true,
  "recovery_available": true,
  "vendor_ramdisk_available": true,
  "package": {
    "serde": {
      "target_windows": true,
      "copy_out": true,
      "rulesmk_patch": "patches/rules.mk.diff"
    }
  },
  "variants": [
    {
      "features": [
        "default",
        "derive",
        "rc"
      ],
      "tests": true
    },
    {
      "features": [
        "alloc",
        "derive"
      ],
      "package": {
        "serde": {
          "alloc": true,
          "force_rlib": true,
          "host_supported": false,
          "no_std": true
        }
      }
    },
    {
      "features": [
        "alloc",
        "default",
        "derive",
        "serde_derive",
        "std"
      ],
      "generate_rulesmk": true,
      "generate_androidbp": false
    }
  ],
  "native_bridge_supported": true
}
