# SPDX-License-Identifier: MIT OR Apache-2.0

[package]
name = "arm-sysregs"
version = "0.4.0"
edition = "2024"
license = "MIT OR Apache-2.0"
description = "Armv8-A system register helper crate"
repository = "https://git.trustedfirmware.org/arm-firmware-crates/arm-sysregs.git"
authors = ["Andrew Walbran <qwandor@google.com>"]
keywords = ["arm", "aarch64", "sysregs", "system", "registers"]
categories = ["hardware-support", "embedded", "no-std", "no-std::no-alloc"]
readme = "README.md"
rust-version = "1.88"

[package.metadata.docs.rs]
all-features = true
rustdoc-args = ["--cfg", "docsrs"]

[dependencies]
arm-sysregs-common = { workspace = true }
arm-sysregs-aarch32 = { workspace = true }
arm-sysregs-el0 = { workspace = true }
arm-sysregs-el1 = { workspace = true, optional = true }
arm-sysregs-el2 = { workspace = true, optional = true }
arm-sysregs-el3 = { workspace = true, optional = true }

[dev-dependencies]
arm-sysregs-aarch32 = { workspace = true, features = [ "fakes" ] }
arm-sysregs-el0 = { workspace = true, features = [ "fakes" ] }
arm-sysregs-el1 = { workspace = true, features = [ "fakes" ] }
arm-sysregs-el2 = { workspace = true, features = [ "fakes" ] }
arm-sysregs-el3 = { workspace = true, features = [ "fakes" ] }
log = { workspace = true }

[features]
el1 = ["dep:arm-sysregs-el1"]
el2 = ["el1", "dep:arm-sysregs-el2", "arm-sysregs-aarch32/el2"]
el3 = ["el2", "dep:arm-sysregs-el3"]
fakes = [
    "arm-sysregs-aarch32/fakes",
    "arm-sysregs-el0/fakes",
    "arm-sysregs-el1?/fakes",
    "arm-sysregs-el2?/fakes",
    "arm-sysregs-el3?/fakes",
]

[lints.clippy]
missing_safety_doc = "deny"
undocumented_unsafe_blocks = "deny"
unreadable_literal = "deny"

[lints.rust]
missing_docs = "deny"
unsafe_op_in_unsafe_fn = "deny"
