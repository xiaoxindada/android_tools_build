{
  "features": [
    "alloc",
    "std",
    "use-libc-auxv",
    "use-libc",
    "mm",
    "net",
    "param",
    "pipe",
    "thread",
    "fs",
    "event",
    "process",
    "time",
    "termios"
  ],
  "min_sdk_version": "30",
  "extra_cfg": [
    "rustix_no_linux_raw"
  ],
  "cfg_blocklist": [
    "linux_like",
    "linux_kernel"
  ],
  "package": {
    "rustix": {
      "add_module_block": "cargo_embargo_target_cfgs.bp.fragment",
      "dep_blocklist": [
        "liblinux_raw_sys"
      ]
    }
  }
}
