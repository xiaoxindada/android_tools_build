{
  "package": {
    "wayland-protocols": {
      "srcs": [
        "src/*.rs",
        "protocols/**/*.xml"
      ]
    }
  },
  "features": [
    "server",
    "staging",
    "unstable"
  ],
  "module_name_overrides": {
    "libwayland_server": "libwayland_server_rs"
  },
  "run_cargo": false,
  "min_sdk_version": "29"
}
