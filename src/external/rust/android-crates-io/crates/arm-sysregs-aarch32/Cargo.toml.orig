# SPDX-License-Identifier: MIT OR Apache-2.0

[package]
name = "arm-sysregs-aarch32"
version = "0.4.0"
edition = "2024"
license = "MIT OR Apache-2.0"
description = "Armv8-A system register helper crate for Aarch32 registers"
repository = "https://git.trustedfirmware.org/arm-firmware-crates/arm-sysregs.git"
authors = ["Andrew Walbran <qwandor@google.com>"]
keywords = ["arm", "aarch32", "sysregs", "system", "registers"]
categories = ["hardware-support", "embedded", "no-std", "no-std::no-alloc"]
readme = "README.md"
rust-version = "1.88"

[package.metadata.docs.rs]
all-features = true
rustdoc-args = ["--cfg", "docsrs"]

[dependencies]
arm-sysregs-common = { workspace = true }
bitflags = { workspace = true }

[dev-dependencies]
arm-sysregs-common = { workspace = true, features = [ "fakes" ] }
log = { workspace = true }

[features]
el2 = []
fakes = ["arm-sysregs-common/fakes"]

[lints.clippy]
missing_safety_doc = "deny"
undocumented_unsafe_blocks = "deny"
unreadable_literal = "deny"

[lints.rust]
missing_docs = "deny"
unsafe_op_in_unsafe_fn = "deny"
