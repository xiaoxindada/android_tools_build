commit 2aa6329553c3435ec48e7c93ceef3ba6b782b35d
Author: jaewan-github <59152909+jaewan-github@users.noreply.github.com>
Date:   Wed Sep 16 08:03:10 2026 +0900

    input/keyboard: Replace sha2 dependency with siphasher

    Replace sha2 dependency with siphasher to reduce compliation time
    and dependency footprint.

    Although siphasher doesn't provide cryptographically secure nor
    256-bit output, it's sufficient for checking keymap collision.

    Tested:
    - cargo test --lib --no-default-features --features wayland_frontend
    - verified that siphasher-128 doesn't cause hash collision with keymaps
      provided by XKB.

diff --git a/Cargo.toml b/Cargo.toml
index dd360d643..42eabbcf3 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -151,6 +151,7 @@ wayland_frontend = [
     "wayland-protocols-wlr",
     "wayland-protocols-misc",
     "tempfile",
+    "siphasher",
 ]
 x11rb_event_source = ["x11rb"]
 xwayland = [
@@ -321,8 +322,9 @@ features = [
 version = "1.1.0"
 optional = true
 
-[dependencies.sha2]
-version = "0.10.9"
+[dependencies.siphasher]
+version = "1.0.3"
