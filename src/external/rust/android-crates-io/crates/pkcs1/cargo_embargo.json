{
  "apex_available": [
    "//apex_available:platform",
    "com.android.virt"
  ],
  "features": [
    "alloc"
  ],
  "module_visibility": {
    "libpkcs1": [
      "//packages/modules/Virtualization:__subpackages__",
      "//system/keymint:__subpackages__"
    ]
  },
  "run_cargo": false,
  "variants": [
    {},
    {
      "package": {
        "pkcs1": {
          "force_rlib": true,
          "host_supported": false,
          "no_std": true
        }
      }
    },
    {
      "generate_androidbp": false,
      "generate_rulesmk": true
    }
  ],
  "min_sdk_version": "29"
}
