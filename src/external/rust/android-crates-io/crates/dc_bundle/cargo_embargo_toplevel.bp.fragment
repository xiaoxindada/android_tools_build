filegroup {
    name: "dc_bundle_protos",
    visibility: ["//visibility:public"],
    srcs: [
        "src/proto/definition/**/*.proto",
        "src/proto/layout_interface/**/*.proto",
        "src/proto/live_update/**/*.proto",
    ],
}

java_library {
    name: "libdc_protos",
    visibility: ["//visibility:public"],
    sdk_version: "current",
    min_sdk_version: "29",
    proto: {
        type: "lite",
        local_include_dirs: [
            "src/proto",
            "src/proto/definition",
            "src/proto/layout_interface",
            "src/proto/live_update",
        ],
        include_dirs: [
            "external/protobuf/src",
        ],
        canonical_path_from_root: false,
    },
    srcs: [
        ":libprotobuf-internal-protos",
        ":dc_bundle_protos",
    ],
    static_libs: [
        "libprotobuf-java-lite",
    ],
}

java_library {
    name: "libdc_kt_protos",
    visibility: ["//visibility:public"],
    sdk_version: "current",
    min_sdk_version: "29",
    proto: {
        type: "kotlin-lite",
        local_include_dirs: [
            "src/proto",
            "src/proto/definition",
            "src/proto/layout_interface",
            "src/proto/live_update",
        ],
        include_dirs: [
            "external/protobuf/src",
        ],
        canonical_path_from_root: false,
    },
    srcs: [
        ":libprotobuf-internal-protos",
        ":dc_bundle_protos",
        "android/Placeholder.kt",
    ],
    static_libs: [
        "libprotobuf-kotlin-lite",
        "libdc_protos",
    ],
}
