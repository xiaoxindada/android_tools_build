-			READ_GLOBAL_MUTEX_PROF_DATA(
-			    global_prof_mutex_prof_recent_alloc,
-			    prof_recent_alloc_mtx);
-			READ_GLOBAL_MUTEX_PROF_DATA(
-			    global_prof_mutex_prof_recent_dump,
-			    prof_recent_dump_mtx);
-			READ_GLOBAL_MUTEX_PROF_DATA(
-			    global_prof_mutex_prof_stats, prof_stats_mtx);
