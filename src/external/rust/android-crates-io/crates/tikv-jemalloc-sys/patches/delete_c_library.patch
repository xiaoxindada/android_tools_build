-	return ph->root;
-}
-
-JEMALLOC_ALWAYS_INLINE void *
-ph_any(ph_t *ph, size_t offset) {
-	if (ph->root == NULL) {
-		return NULL;
-	}
-	void *aux = phn_next_get(ph->root, offset);
-	if (aux != NULL) {
-		return aux;
-	}
-	return ph->root;
-}
