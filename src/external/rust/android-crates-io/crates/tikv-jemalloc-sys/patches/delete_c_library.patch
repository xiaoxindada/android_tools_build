-		opt_oversize_threshold = 0;
-		oversize_threshold = SC_LARGE_MAXCLASS + PAGE;
-		huge_enabled = false;
-	} else {
-		/* Reserve the index for the huge arena. */
-		huge_arena_ind = narenas_total_get();
-		oversize_threshold = opt_oversize_threshold;
-		huge_enabled = true;
-	}
-
-	return huge_enabled;
-}
