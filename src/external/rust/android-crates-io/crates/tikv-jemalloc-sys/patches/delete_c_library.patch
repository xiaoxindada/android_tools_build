-			    "Should have found a slab");
-			expect_zu_eq(nactive,
-			    psset->stats.nonfull_slabs[i][0].nactive,
-			    "Mismatch in active pages");
-		} else {
-			stats_expect_empty(&psset->stats.nonfull_slabs[i][0]);
-		}
-	}
