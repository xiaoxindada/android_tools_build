-static size_t
-hpa_ndirty_max(tsdn_t *tsdn, hpa_shard_t *shard) {
-	malloc_mutex_assert_owner(tsdn, &shard->mtx);
-	if (shard->opts.dirty_mult == (fxp_t)-1) {
-		return (size_t)-1;
-	}
-	return fxp_mul_frac(psset_nactive(&shard->psset),
-	    shard->opts.dirty_mult);
