-JEMALLOC_ALLOC_SIZE(2)
-je_rallocx(void *ptr, size_t size, int flags) {
-	LOG("core.rallocx.entry", "ptr: %p, size: %zu, flags: %d", ptr,
-	    size, flags);
-	void *ret = do_rallocx(ptr, size, flags, false);
-	LOG("core.rallocx.exit", "result: %p", ret);
