-	int next_idx = 0;
-	/* Push first quarter 1-at-a-time. */
-	for (int i = 0; i < NELEMS / 4; i++) {
-		elem_mpsc_queue_push(&queue, &elems[next_idx]);
-		next_idx++;
-	}
-	/* Push second quarter in batch. */
-	for (int i = NELEMS / 4; i < NELEMS / 2; i++) {
