-static bool
-hpa_good_hugification_candidate(hpa_shard_t *shard, hpdata_t *ps) {
-	/*
-	 * Note that this needs to be >= rather than just >, because of the
-	 * important special case in which the hugification threshold is exactly
-	 * HUGEPAGE.
