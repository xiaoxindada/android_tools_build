-
-	if (!ctl_initialized && ctl_init(tsd)) {
-		ret = EAGAIN;
-		goto label_return;
-	}
-
-	ret = ctl_lookupbymib(tsd_tsdn(tsd), &node, mib, miblen);
-	if (ret != 0) {
-		goto label_return;
-	}
-	if (node == NULL || node->ctl != NULL) {
-		ret = ENOENT;
-		goto label_return;
-	}
-
-	assert(miblenp != NULL);
-	assert(*miblenp >= miblen);
-	*miblenp -= miblen;
-	/*
-	 * The same node supplies the starting node and stores the ending node.
