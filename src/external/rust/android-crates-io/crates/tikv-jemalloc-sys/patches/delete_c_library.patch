-
-	thd_join(popper, NULL);
-	for (int i = 0; i < NPUSHERS; i++) {
-		thd_join(pushers[i], NULL);
-	}
-
-	for (int i = 0; i < NPUSHERS; i++) {
-		expect_d_eq(NELEMS_PER_PUSHER, pusher_counts[i], "");
-	}
-
-	free(elems);
-}
-TEST_END
-
-int
-main(void) {
