-	unsigned arena_ind = arenas_create_mallctl();
-	size_t nregs_per_run = nregs_per_run_compute();
-	size_t nregs = nregs_per_run * NSLABS;
-	VARIABLE_ARRAY(void *, ptrs, nregs);
-	size_t i, j, offset;
