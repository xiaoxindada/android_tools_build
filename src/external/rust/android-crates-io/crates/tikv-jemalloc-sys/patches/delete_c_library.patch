-		    KQU(1000000));
-		nstime_idivide(&decay->interval, SMOOTHSTEP_NSTEPS);
-	}
-
-	nstime_copy(&decay->epoch, cur_time);
-	decay->jitter_state = (uint64_t)(uintptr_t)decay;
-	decay_deadline_init(decay);
