-		expect_true(ret, "Unexpected fill failure");
-	}
-	expect_true(cache_bin_ncached_get_local(bin, info) == nfill,
-	    "Wrong cached count");
-
-	/* Stash */
-	for (cache_bin_sz_t i = 0; i < nstash; i++) {
-		ret = cache_bin_stash(bin, &ptrs[i + nfill]);
