-        Option.as_configure_flag('--enable-debug'),
-        CL,
-        CROSS_COMPILE_32BIT,
-    )
-    return generate_jobs(os, arch, (), max_unusual_opts, unusuals)
-
-
-def generate_freebsd(arch):
