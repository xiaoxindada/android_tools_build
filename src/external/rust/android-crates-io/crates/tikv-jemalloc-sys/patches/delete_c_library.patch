-    - os: linux
-      env: CC=gcc CXX=g++ CONFIGURE_FLAGS="--enable-debug \
---enable-experimental-smallocx --enable-stats --enable-prof" \
-EXTRA_CFLAGS="-Werror -Wno-array-bounds"
