-	assert(err == 0);
-
-	prof_backtrace_hook_set(mock_backtrace);
-	do_allocs(16, 32 * 1024 * 1024, /* do_frees */ true);
-	do_allocs(32 * 1024* 1024, 16, /* do_frees */ true);
