-	CPU_SPINWAIT;
-#  else
-	volatile int x = 0;
-	x = x;
-#  endif
-}
-
-static inline void
-spin_adaptive(spin_t *spin) {
-	volatile uint32_t i;
-
-	if (spin->iteration < 5) {
-		for (i = 0; i < (1U << spin->iteration); i++) {
-			spin_cpu_spinwait();
-		}
-		spin->iteration++;
