-			malloc_mutex_prof_max_update(tsdn,
-			    &stats->max_counter_per_bg_thd, &info->mtx);
-		}
-		malloc_mutex_unlock(tsdn, &info->mtx);
-	}
-	stats->num_runs = num_runs;
-	if (num_runs > 0) {
-		nstime_idivide(&stats->run_interval, num_runs);
-	}
