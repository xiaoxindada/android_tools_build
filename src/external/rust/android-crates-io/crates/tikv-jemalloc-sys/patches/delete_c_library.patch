-static bool
-hpa_should_purge(tsdn_t *tsdn, hpa_shard_t *shard) {
-	malloc_mutex_assert_owner(tsdn, &shard->mtx);
-	if (hpa_adjusted_ndirty(tsdn, shard) > hpa_ndirty_max(tsdn, shard)) {
-		return true;
-	}
-	if (hpa_hugify_blocked_by_ndirty(tsdn, shard)) {
-		return true;
-	}
-	return false;
-}
