-	{(t)-1, (t) 1, (t)-2},						\
-									\
-	{(t) 0, (t)-1, (t)-2},						\
-	{(t) 0, (t) 0, (t)-2},						\
-	{(t) 0, (t) 1, (t)-2},						\
-									\
-	{(t) 1, (t)-1, (t)-2},						\
-	{(t) 1, (t) 0, (t)-2},						\
-	{(t) 1, (t) 1, (t)-2},						\
-									\
-	{(t)0, (t)-(1 << 22), (t)-2},					\
-	{(t)0, (t)(1 << 22), (t)-2},					\
-	{(t)(1 << 22), (t)-(1 << 22), (t)-2},				\
-	{(t)(1 << 22), (t)(1 << 22), (t)-2}				\
-}
-
-#define TEST_BODY(t, ta) do {						\
-	const ta##_test_t tests[] = TEST_CASES(t);			\
-	for (unsigned i = 0; i < sizeof(tests)/sizeof(tests[0]); i++) {	\
