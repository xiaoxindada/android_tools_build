-void
-prof_malloc_sample_object(tsd_t *tsd, const void *ptr, size_t size,
-    size_t usize, prof_tctx_t *tctx) {
-	cassert(config_prof);
-
-	if (opt_prof_sys_thread_name) {
-		prof_sys_thread_name_fetch(tsd);
