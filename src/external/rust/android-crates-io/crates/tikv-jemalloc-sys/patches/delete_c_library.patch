-			    "Unexpected first unset bit");
-			expect_zu_eq(bitmap_sfu(bitmap, binfo), i+2,
-			    "Unexpected first unset bit");
-		}
-	}
-
-	/*
-	 * Unset the last bit, bubble another unset bit through the bitmap, and
