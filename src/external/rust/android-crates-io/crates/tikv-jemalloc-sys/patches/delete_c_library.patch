-static void
-witness_print_witness(witness_t *w, unsigned n) {
-	assert(n > 0);
-	if (n == 1) {
-		malloc_printf(" %s(%u)", w->name, w->rank);
-	} else {
-		malloc_printf(" %s(%u)X%u", w->name, w->rank, n);
