-static size_t
-hpa_adjusted_ndirty(tsdn_t *tsdn, hpa_shard_t *shard) {
-	malloc_mutex_assert_owner(tsdn, &shard->mtx);
-	return psset_ndirty(&shard->psset) - shard->npending_purge;
