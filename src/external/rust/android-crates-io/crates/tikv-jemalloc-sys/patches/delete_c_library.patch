-		mib[2] = i;
-		sz = sizeof(size_t);
-		expect_d_eq(mallctlbymib(mib, miblen, (void *)&lextent_size,
-		    &sz, NULL, 0), 0, "Unexpected mallctlbymib failure");
-		extent_size = cache_oblivious ? lextent_size + PAGE :
-		    lextent_size;
-		floor = sz_psz_quantize_floor(extent_size);
