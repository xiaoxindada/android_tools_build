-static inline int
-edata_esn_comp(const edata_t *a, const edata_t *b) {
-	size_t a_esn = edata_esn_get(a);
-	size_t b_esn = edata_esn_get(b);
-
-	return (a_esn > b_esn) - (a_esn < b_esn);
-}
