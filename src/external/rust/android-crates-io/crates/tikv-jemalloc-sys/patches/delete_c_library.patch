-	expect_simple_consistency(&tree, /* specialness */ 1, /* empty */ false,
-	    /* first */ &nodes[2], /* last */ &nodes[8]);
-
-	/*
-	 * If we remove 2, a first-search we should go back to 4, while a
-	 * last-search should remain unchanged.
