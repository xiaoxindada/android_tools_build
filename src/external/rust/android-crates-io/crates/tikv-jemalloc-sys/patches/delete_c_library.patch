-	 */
-
-	sz = sizeof(bool);
-	expect_d_eq(mallctl("opt.cache_oblivious", (void *)&cache_oblivious,
-	    &sz, NULL, 0), 0, "Unexpected mallctl failure");
-
-	sz = sizeof(unsigned);
-	expect_d_eq(mallctl("arenas.nlextents", (void *)&nlextents, &sz, NULL,
