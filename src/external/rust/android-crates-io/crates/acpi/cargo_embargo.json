{
  "run_cargo": false,
  "package": {
    "acpi": {
      "no_std": true,
      "rulesmk_patch": "patches/rules.mk.diff"
    }
  },
  "variants": [
    {
      "package": {
        "acpi": {
          "host_supported": false
        }
      },
      "module_name_overrides": {
        "libbit_field": "libbit_field_nostd",
        "libbyteorder": "libbyteorder_nostd",
        "libspinning_top": "libspin"
      }
    },
    {
      "generate_androidbp": false,
      "generate_rulesmk": true
    }
  ],
  "min_sdk_version": "29"
}
