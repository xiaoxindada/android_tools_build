{
  "min_sdk_version": "29",
  "module_blocklist": [
    "tinyvec_test_src_lib"
  ],
  "run_cargo": false,
  "variants": [
    {
      "features": [
        "alloc",
        "default",
        "std",
        "tinyvec_macros",
        "rustc_1_57"
      ],
      "tests": false
    },
    {
      "features": [],
      "package": {
        "tinyvec": {
          "force_rlib": true,
          "host_supported": false,
          "no_std": true
        }
      },
      "generate_rulesmk": true
    }
  ]
}
