{
  "features": [
    "derive",
    "extern_crate_alloc"
  ],
  "min_sdk_version": "29",
  "package": {
    "bytemuck": {
      "target_windows": true
    }
  },
  "variants": [
    {
      "features": [
        "extern_crate_std",
        "derive",
        "extern_crate_alloc",
        "min_const_generics"
      ],
      "tests": true,
      "min_sdk_version": "31"
    },
    {
      "module_name_overrides": {
        "libbytemuck": "libbytemuck_nostd"
      },
      "package": {
        "bytemuck": {
          "force_rlib": true,
          "host_supported": false,
          "alloc": true,
          "no_std": true
        }
      }
    }
  ],
  "recovery_available": true
}
