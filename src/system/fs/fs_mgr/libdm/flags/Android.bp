aconfig_declarations {
    name: "libdm_aconfig_declarations",
    package: "com.android.libdm",
    container: "system",
    srcs: [
        "libdm_flags.aconfig",
    ],
}

cc_aconfig_library {
    name: "libdm_flags_cc_lib",
    aconfig_declarations: "libdm_aconfig_declarations",
    host_supported: true,
    mode: "force-read-only",
    ramdisk_available: true,
    recovery_available: true,
    vendor_ramdisk_available: true,
}
