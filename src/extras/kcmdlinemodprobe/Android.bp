package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_library_static {
    name: "libkcmdlinemodprobe_cpp",
    srcs: ["kcmdlinemodprobe_cpp.cc"],
    generated_headers: [
        "cxx-bridge-header",
        "kcmdlinemodprobe_bridge_header",
    ],
    generated_sources: ["kcmdlinemodprobe_bridge_code"],
    static_libs: [
        "libmodprobe",
    ],
    shared_libs: [
        "libbase",
        "liblog",
    ],
}

genrule {
    name: "kcmdlinemodprobe_bridge_code",
    tools: ["cxxbridge"],
    cmd: "$(location cxxbridge) $(in) > $(out)",
    srcs: ["main.rs"],
    out: ["kcmdlinemodprobe_cxx_generated.cc"],
}

genrule {
    name: "kcmdlinemodprobe_bridge_header",
    tools: ["cxxbridge"],
    cmd: "$(location cxxbridge) $(in) --header > $(out)",
    srcs: ["main.rs"],
    out: ["main.rs.h"],
}

rust_binary {
    name: "kcmdlinemodprobe",
    srcs: ["main.rs"],
    rustlibs: [
        "libandroid_logger",
        "libcxx",
        "liblog_rust",
        "liblogger",
    ],
    static_libs: [
        "libkcmdlinemodprobe_cpp",
        "libmodprobe",
    ],
    shared_libs: [
        "libbase",
        "liblog",
    ],
    init_rc: ["kcmdlinemodprobe.rc"],
}
